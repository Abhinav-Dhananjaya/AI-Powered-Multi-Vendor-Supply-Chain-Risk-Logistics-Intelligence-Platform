# ---- PostgreSQL (with pgvector) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scm
PG_POOL_MAX=10
PG_SSL=false                      # set true for managed Postgres (Neon, Supabase, RDS)

# ---- MongoDB Atlas ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scm_telemetry

# ---- Embedding microservice (FastAPI) ----
EMBEDDING_SERVICE_URL=http://localhost:8000
EMBEDDING_API_KEY=change-me-shared-secret

# ---- Auth ----
JWT_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
